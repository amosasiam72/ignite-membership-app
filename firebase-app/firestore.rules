rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    
    function isSelfServiceProfileUpdate() {
      return changedKeys().hasOnly([
        'firstName',
        'lastName',
        'dob',
        'phone',
        'email',
        'instagram',
        'tiktok',
        'photo',
        'updatedAt',
        'pin'
      ]);
    }
    
    function isSelfServicePinStateUpdate() {
      // Anonymous callers may only touch the lockout counters and the
      // reset-request guard flags. pinHash and pinSalt are deliberately NOT here:
      // allowing those alongside the hash would let anyone rewrite both and sign
      // in as that member with a PIN they chose.
      return changedKeys().hasOnly([
        'pinFailedAttempts',
        'pinLockedUntil',
        'pinResetPending',
        'pinResetRequestCount',
        'pinResetRequestedAt'
      ]);
    }
    
    function isValidPinResetRequestCreate() {
      return request.resource.data.keys().hasOnly([
        'memberId',
        'memberName',
        'email',
        'phone',
        'reason',
        'status',
        'createdAt'
      ])
      && request.resource.data.memberId is string
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt is string
      && request.resource.data.memberName.size() > 0
      && request.resource.data.memberName.size() <= 120
      && request.resource.data.email.size() <= 200
      && request.resource.data.phone.size() <= 40
      && request.resource.data.reason.size() <= 500
      && (request.resource.data.email.size() > 0 || request.resource.data.phone.size() > 0);
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() || isSelfServiceProfileUpdate();
      allow delete: if isAuthenticated();
    }
    
    match /memberPin/{memberId} {
      // A create only ever applies when no PIN document exists yet. Anonymous
      // callers are limited to ids that have no member document, so someone
      // cannot plant a known salt/hash on an existing membership and log in as
      // that member. Registration writes the PIN first, then the member record.
      allow read: if true;
      allow create: if isAuthenticated() || !exists(/databases/$(database)/documents/members/$(memberId));
      allow update: if isAuthenticated() || isSelfServicePinStateUpdate();
      allow delete: if isAuthenticated();
    }
    
    match /pinResetRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isValidPinResetRequestCreate();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
